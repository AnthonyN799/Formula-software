[supabase]
url = "https://your-project.supabase.co"
key = "your-supabase-key"

[auth]
admin_passcode = "replace-with-a-strong-admin-passcode"
anthony_password = "replace-with-anthony-password"
fadia_password = "replace-with-fadia-password"

# Optional detailed format if you want more users/roles:
[auth.users.anthony]
password = "replace-with-a-strong-password"
role = "admin"

[auth.users.fadia]
password = "replace-with-a-strong-password"
role = "Analyst"
